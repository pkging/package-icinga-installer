#!/bin/sh
# preinst script for icinga-installer
#
# see: dh_installdeb(1)

set -e

# summary of how this script can be called:
#        * <new-preinst> `install'
#        * <new-preinst> `install' <old-version>
#        * <new-preinst> `upgrade' <old-version>
#        * <old-preinst> `abort-upgrade' <new-version>
# for details, see https://www.debian.org/doc/debian-policy/ or
# the debian-policy package

# Patch to support PostgreSQL also on Ubuntu 26.04 (resolute)
sed -i "/\/^(24.04)$\/ => '16',/a\        \/^(26.04)$\/ => '18'," /usr/share/icinga-installer/modules/postgresql/manifests/globals.pp

chmod 600 /etc/icinga-installer/custom-hiera.yaml
chmod 600 /etc/icinga-installer/scenarios.d/*

# cleanup on purge
if [ "$1" = "purge" ]; then
    rm -rf /etc/icinga-installer
    rm -rf /var/log/icinga-installer
fi

# dh_installdeb will replace this with shell code automatically
# generated by other debhelper scripts.

#DEBHELPER#

exit 0
